# macOS Finder artifacts
.DS_Store

# Local tooling, if/when we add build scripts (Phase 2+)
__pycache__/
*.pyc
node_modules/

# Hike-entry pipeline (Phase 3): raw drop-off folder, local secrets, backups
intake/
tools/cloudinary-credentials.json
*.bak

# Intro-film renders: the baked video is delivered through Cloudinary, never
# committed — a binary that grows every time the film is re-cut is exactly the
# thing git is worst at. tools/render-intro.py builds its own venv here too.
renders/
tools/.render-venv/

# Claude Code state. GOLDEN RULE: nothing specific to this machine is ever
# published to the public repo. So this is DEFAULT-DENY — everything inside
# .claude/ is ignored, and anything a future plugin or hook drops in there is
# ignored automatically rather than having to be spotted first.
# settings.local.json alone is ~82 KB of permission rules full of absolute
# /Users/ paths. The one exception is .claude/skills/, which is project
# knowledge in the same category as CLAUDE.md and belongs in the repo.
.claude/*
!.claude/skills/
